{
  "name": "carpur",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:e2e": "playwright test",
    "db:migrate:http": "node --env-file=.env.local scripts/migrate-neon.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@react-three/fiber": "^9.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.0.0",
    "next": "16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
