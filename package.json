{
  "name": "carpur",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:e2e": "playwright test",
    "db:migrate:http": "node --env-file=.env.local scripts/migrate-neon.mjs",
    "assets:check": "node scripts/validate-3d-assets.mjs public/models --require-assets && node --test scripts/validate-3d-assets.selfcheck.mjs",
    "deps:check": "node scripts/check-dependency-consistency.mjs",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@react-three/fiber": "^9.8.2",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "three": "^0.186.1",
    "ws": "8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "8.18.2",
    "dotenv": "18.0.9",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "type": "module"
}
